# Environment Variables voor Production (Render + Neon)
# Kopieer dit bestand naar .env.production en vul de juiste waarden in

# Database - Neon PostgreSQL
# Krijg deze URL van je Neon dashboard (https://console.neon.tech)
DATABASE_URL="postgresql://[user]:[password]@[host]/eventify-postgress?sslmode=require"

# NextAuth Configuration
# Voor production moet dit je domein zijn
NEXTAUTH_URL="https://eventiphy.site"

# Genereer een sterke secret met: openssl rand -base64 32
NEXTAUTH_SECRET="[genereer-een-veilige-random-string]"

# App Configuration
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://eventiphy.site"

# Optional: Email Service (voor notificaties)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"

# Optional: File Storage (S3-compatible)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="eu-central-1"
# AWS_S3_BUCKET="eventify-uploads"

# Optional: Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
