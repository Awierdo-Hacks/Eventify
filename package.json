{
  "name": "eventiphy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Eventiphy — marketplace voor evenementdienstverleners",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-deploy-env.mjs && node scripts/migrate-on-deploy.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "vercel-build": "prisma generate && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "node-ical": "^0.27.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv": "^17.4.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
