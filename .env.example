# ─────────────────────────────────────────────────────────────────────────────
# This file is committed to git and visible to everyone with access to the
# repository. It must only ever contain EXAMPLE values.
#
# Put your real values in a file named `.env` (same folder). That file is
# ignored by git and stays on your machine. On Vercel, real values live under
# Project → Settings → Environment Variables — not in any file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Never commit a real connection string.
# On Vercel with a connected Postgres store you can leave this unset: the app
# also reads DATABASE_URL_POSTGRES_URL, DATABASE_URL_DATABASE_URL and POSTGRES_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventiphy_dev"
# Max connections per server instance (keep low on serverless hosts).
# DATABASE_POOL_MAX=5

# ── Sessions ────────────────────────────────────────────────────────────────
# Signs the session cookie. Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=""

# ── Site ────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Calendar sync (optional) ────────────────────────────────────────────────
# 64 hex characters. Generate with: openssl rand -hex 32
CALENDAR_ENCRYPTION_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the redirect URI registered in Google Cloud:
# <NEXT_PUBLIC_APP_URL>/api/calendar/google/callback
GOOGLE_REDIRECT_URI=""

# ── File storage ────────────────────────────────────────────────────────────
# Leave empty to store uploads on local disk (public/uploads) — fine for
# development and for hosts with a persistent disk. On serverless hosts set a
# Vercel Blob token; uploads then go to object storage automatically.
BLOB_READ_WRITE_TOKEN=""

# ── Analytics (optional, loads only after cookie consent) ───────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Demo accounts (test environments only) ──────────────────────────────────
# Shows a button on the login page to sign in as a demo customer, provider or
# administrator with one click; the accounts and sample data are created the
# first time it is used. On by default in `npm run dev`.
# NEVER set this to 1 on the live site: anyone could then sign in as admin.
# DEMO_ACCOUNTS=1
