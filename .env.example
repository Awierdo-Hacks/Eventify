# ── Database ────────────────────────────────────────────────────────────────
# Same database as v1. Never commit a real connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventiphy_dev"
# Max connections per server instance (keep low on serverless hosts).
# DATABASE_POOL_MAX=5

# ── Sessions ────────────────────────────────────────────────────────────────
# Signs the session cookie. Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=""

# ── Site ────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Calendar sync (optional) ────────────────────────────────────────────────
# 64 hex characters. Generate with: openssl rand -hex 32
CALENDAR_ENCRYPTION_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the redirect URI registered in Google Cloud:
# <NEXT_PUBLIC_APP_URL>/api/calendar/google/callback
GOOGLE_REDIRECT_URI=""

# ── File storage ────────────────────────────────────────────────────────────
# Leave empty to store uploads on local disk (public/uploads) — fine for
# development and for hosts with a persistent disk. On serverless hosts set a
# Vercel Blob token; uploads then go to object storage automatically.
BLOB_READ_WRITE_TOKEN=""

# ── Analytics (optional, loads only after cookie consent) ───────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
