# Copy to .env for local development. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.

# --- Database (Prisma Postgres via the Vercel Marketplace) ---
# One of these is enough; see lib/database-url.ts
DATABASE_URL=
# DATABASE_URL_POSTGRES_URL=
# DATABASE_URL_PRISMA_DATABASE_URL=
# Optional: max DB connections per instance (e.g. 1 for `prisma dev`)
DATABASE_POOL_MAX=

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public base URL, e.g. https://eventiphy.be (used for OAuth redirects)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Uploads (Vercel Blob; without it uploads go to public/uploads locally) ---
BLOB_READ_WRITE_TOKEN=

# --- Rate limiting (Upstash Redis via the Vercel Marketplace; in-memory fallback locally) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Calendar sync ---
# 64 hex characters, generate with: openssl rand -hex 32 (required in production)
CALENDAR_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# --- Scheduled jobs (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=

# --- Payments (Mollie) ---
# off = no online payments (default, until the company has a verified Mollie account)
# test = Mollie test mode (demo environment), live = real payments
NEXT_PUBLIC_PAYMENTS_MODE=off
MOLLIE_API_KEY=
MOLLIE_API_KEY_TEST=

# --- Demo environment only: shows one-click demo logins ---
NEXT_PUBLIC_DEMO_MODE=false
