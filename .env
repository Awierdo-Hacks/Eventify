# Database Connection
# Standaard PostgreSQL connection (vervang met je eigen credentials)
# Als je PostgreSQL nog niet geïnstalleerd hebt, installeer het of gebruik Docker:
# docker run --name eventify-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventify?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"